{
  "kind": "collectionType",
  "collectionName": "user_profiles",
  "info": {
    "singularName": "user-profile",
    "pluralName": "user-profiles",
    "displayName": "User Profile"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "user_id": {
      "type": "integer",
      "required": true,
      "unique": true,
      "min": 1
    },
    "regions": {
      "type": "json",
      "default": []
    },
    "property_types": {
      "type": "json",
      "default": []
    },
    "price_from": {
      "type": "decimal",
      "min": 0
    },
    "price_to": {
      "type": "decimal",
      "min": 0
    },
    "area_from": {
      "type": "decimal",
      "min": 0
    },
    "area_to": {
      "type": "decimal",
      "min": 0
    },
    "stop_words": {
      "type": "json",
      "default": []
    },
    "digest_email": {
      "type": "text"
    },
    "digest_enabled": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "profile_version": {
      "type": "integer",
      "default": 1,
      "required": true,
      "min": 1
    }
  }
}
