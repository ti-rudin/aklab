{
  "name": "aklab",
  "version": "1.1.90",
  "main": "ecosystem-local.config.js",
  "workspaces": [
    "lib/*",
    "services/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:parser-contracts": "STRAPI_API_TOKEN=test-only-placeholder-token NODE_ENV=test vitest run services/_shared/src/__tests__/property-location.test.ts services/_shared/src/__tests__/parser-diagnostics.test.ts services/_shared/src/__tests__/parser-probe.test.ts services/_shared/__tests__/parser-error.test.ts services/_shared/__tests__/parse-handler.test.ts services/_shared/__tests__/strapi-client.test.ts services/parser-*/src/__tests__/extraction.test.ts api/src/services/__tests__/parser-error-safety.test.ts api/src/services/__tests__/parser-run-telemetry.test.ts api/src/services/__tests__/parser-source-health.test.ts api/src/services/__tests__/parser-source-quarantine.test.ts api/src/services/__tests__/parser-health-alerts.test.ts api/src/services/__tests__/parser-canary.test.ts api/src/api/parser-run-source/controllers/__tests__/parser-run-source.test.ts api/src/api/source/controllers/__tests__/source.test.ts api/src/services/pipeline/__tests__/stages.test.ts api/src/api/cron/controllers/__tests__/cron.test.ts api/src/cron/__tests__/cron-registration.test.ts api/src/api/__tests__/route-auth.test.ts",
    "test:e2e": "BASE_URL=\"${SMOKE_UI_URL:-http://127.0.0.1:5174}\" npm --prefix app run test:e2e -- --reporter=line",
    "smoke": "node scripts/smoke-test.js",
    "smoke:local": "node scripts/smoke-test.js --local",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "check-env": "node scripts/check-env.js",
    "health-check": "node scripts/health-check.js",
    "setup:local": "cp .env.template .env && echo 'Edit .env with your values'",
    "build:lib": "npm -w @aklab/sqlite-queue run build",
    "db:migrate-property-identity": "node scripts/migrate-property-identity.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "",
  "license": "ISC",
  "description": "AKLAB — мониторинг коммерческой недвижимости (торги по банкротству)",
  "dependencies": {
    "@strapi/provider-email-nodemailer": "5.50.2",
    "dotenv": "^17.4.2",
    "nodemailer": "9.0.3"
  },
  "overrides": {
    "nodemailer": "9.0.3",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^11.10.0",
    "jsdom": "^29.1.1",
    "node-cron": "^3.0.3",
    "playwright": "^1.60.0",
    "typescript": "^6.0.0",
    "uuid": "^10.0.0"
  }
}
